# Example environment variables for the backend.
# Copy the values you need into your shell or hosting dashboard.
# Never commit a real .env file.

# Set to true only for local development. Leave unset or false in production.
DJANGO_DEBUG=false

# Required whenever DJANGO_DEBUG is not true. Use a long random value.
DJANGO_SECRET_KEY=replace-with-a-long-random-value

# Comma-separated host names this server answers to.
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=https://example.com

# Set to false if your host already redirects HTTP to HTTPS before the app.
DJANGO_SECURE_SSL_REDIRECT=true

# Request limits per client address. Leave unset in production to use the
# built-in defaults (5/min for login, 10/hour for registration). Raise them
# only for local or automated end-to-end test runs.
# DJANGO_THROTTLE_TOKEN_RATE=5/min
# DJANGO_THROTTLE_REGISTER_RATE=10/hour
